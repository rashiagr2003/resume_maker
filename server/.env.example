# Server Port
PORT=8080

# Primary AI Provider: Google Gemini
# Obtain key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Fallback AI Provider: Groq (Llama 3.3 / Mixtral)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origin (set to your Flutter Web domain in production, or * for dev)
ALLOWED_CORS_ORIGIN=*
