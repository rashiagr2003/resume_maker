# ==============================================================
# Resume Maker - Environment Configuration Template
# ==============================================================
# Copy this file to .env or server/.env and supply your private keys.
# NEVER commit your actual .env file or real API keys to git!
# ==============================================================

# Server Port
PORT=8080

# Primary AI Provider: Google Gemini
# Free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Fallback AI Provider: Groq
# Free API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Allowed Origin (e.g., https://your-resume-app.web.app or * for local dev)
ALLOWED_CORS_ORIGIN=*
